# Copy this file to `.env` (it is git-ignored) and fill in your Supabase project values.
# Supabase Dashboard → Project Settings → API (or "API Keys")
#
# Use the Project URL and the *publishable* key (older projects call it the "anon" key).
# NEVER put the service_role / secret key here: anything EXPO_PUBLIC_* is bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
